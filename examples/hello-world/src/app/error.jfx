import type { JavafyErrorProps } from "javafy/router";
export default function ErrorPage({ error, reset }: JavafyErrorProps) {
  return <main role="alert" style={{ maxWidth: 720, margin: "12vh auto", padding: 24 }}><p className="eyebrow">JAVAfy ERROR</p><h1>Something went wrong.</h1><p>{error.message}</p><button className="button" onClick={reset}>Try again</button></main>;
}
