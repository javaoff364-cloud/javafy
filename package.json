{
  "name": "javafy",
  "version": "0.2.0",
  "private": true,
  "description": "A high-performance TypeScript fullstack framework.",
  "license": "MIT",
  "packageManager": "npm@10",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty",
    "test": "node --test",
    "dev": "node packages/cli/dist/index.js dev",
    "dev:example": "npm run build && cd examples/hello-world && node ../../packages/cli/dist/index.js dev",
    "build:example": "npm run build && cd examples/hello-world && node ../../packages/cli/dist/index.js build",
    "typecheck:example": "tsc --noEmit -p examples/hello-world/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "dependencies": {
    "esbuild": "^0.25.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
