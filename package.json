{
  "name": "javafy",
  "version": "1.0.0",
  "private": true,
  "description": "A high-performance TypeScript fullstack framework.",
  "license": "MIT",
  "packageManager": "npm@10",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty",
    "test": "node --test",
    "dev": "npm run dev:example",
    "dev:example": "npm run build && cd examples/hello-world && node ../../packages/cli/dist/index.js dev",
    "build:example": "npm run build && cd examples/hello-world && node ../../packages/cli/dist/index.js build",
    "start:example": "cd examples/hello-world && node ../../packages/cli/dist/index.js start",
    "typecheck:example": "tsc --noEmit -p examples/hello-world/tsconfig.json",
    "benchmark": "node scripts/benchmark.mjs",
    "test:packages": "node scripts/package-smoke.mjs",
    "test:production": "npm run build && npm run typecheck:example && npm run build:example && node scripts/verify-production.mjs",
    "audit": "npm audit --omit=dev"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "dependencies": {
    "@javafy/core": "1.0.0",
    "@javafy/cli": "1.0.0",
    "@javafy/router": "1.0.0",
    "@javafy/server": "1.0.0",
    "esbuild": "^0.25.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
