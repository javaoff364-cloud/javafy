{
  "name": "javafy",
  "version": "0.2.0",
  "private": true,
  "description": "A high-performance TypeScript fullstack framework.",
  "license": "MIT",
  "packageManager": "npm@10",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && node packages/cli/dist/index.js build",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty",
    "test": "node --test",
    "dev": "node packages/cli/dist/index.js dev"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "dependencies": {
    "esbuild": "^0.25.5"
  }
}
