{
  "name": "@javafy/router",
  "version": "1.0.1",
  "description": "File-based React router for Javafy applications.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "dependencies": {
    "@javafy/core": "1.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/javaoff364-cloud/javafy.git",
    "directory": "packages/router"
  },
  "homepage": "https://github.com/javaoff364-cloud/javafy#readme",
  "bugs": {
    "url": "https://github.com/javaoff364-cloud/javafy/issues"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "javafy",
    "typescript",
    "react",
    "fullstack",
    "router"
  ]
}
