    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/javaoff364-cloud/javafy.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/javaoff364-cloud/javafy#readme",
  "bugs": {
    "url": "https://github.com/javaoff364-cloud/javafy/issues"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "javafy",
    "typescript",
    "react",
    "fullstack",
    "core"
  ]
